# Copia este archivo como ".env" (sin .example) y coloca ahi tus datos reales.
# El archivo .env NUNCA se comparte ni se sube a ningun repositorio.

# API Key del proyecto en Kapso
# Se obtiene en el dashboard de Kapso, en Project Settings, API Keys
KAPSO_API_KEY=

# Phone Number ID del numero de WhatsApp Business conectado en Kapso
KAPSO_PHONE_NUMBER_ID=

# Tu propio numero de WhatsApp para hacer la prueba antes de la campana real
# Formato internacional, sin el signo mas ni espacios (ej: 573001234567)
NUMERO_DE_PRUEBA=

# Nombre exacto de la plantilla ya creada y aprobada por Meta
NOMBRE_PLANTILLA=invitacion_foro_seguridad

# Idioma de la plantilla
IDIOMA_PLANTILLA=es
